def frontendImage

pipeline {

    agent any

    environment {

        // Docker build context
        BUILD_CONTEXT = './frontend'
        BACKEND_DOCKERFILE = './frontend/Dockerfile'

        // Same Docker image repository for all environments
        FRONTEND_IMAGE_DEV  = 'achalpadol/app-4-proxy'
        FRONTEND_IMAGE_QA   = 'achalpadol/app-4-proxy'
        FRONTEND_IMAGE_UAT  = 'achalpadol/app-4-proxy'
        FRONTEND_IMAGE_PROD = 'achalpadol/app-4-proxy'

        // Common frontend image
        FRONTEND_IMAGE = 'achalpadol/app-4-proxy'

        // Docker Hub
        REGISTRY_URL = 'https://index.docker.io/v1/'

        // Jenkins Docker Hub credential
        DEV_DH_CREDENTIALS  = '02_docker_hub_creds'
        QA_DH_CREDENTIALS   = '02_docker_hub_creds'
        UAT_DH_CREDENTIALS  = '02_docker_hub_creds'
        PROD_DH_CREDENTIALS = '02_docker_hub_creds'

        // AWS / EKS
        AWS_REGION  = 'ap-south-1'
        EKS_CLUSTER = 'achal-cluster-1'

        // Kubernetes namespaces
        DEV_NS  = 'app4-dev'
        QA_NS   = 'app4-qa'
        UAT_NS  = 'app4-uat'
        PROD_NS = 'app4-prod'
    }

    parameters {

        choice(
            name: 'Environment',
            choices: ['dev', 'qa', 'uat', 'prod'],
            description: 'Select deployment environment'
        )

        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'For QA/UAT/PROD, enter the Docker image tag created by DEV. Example: 25'
        )
    }

    stages {

        stage('Checkout') {

            steps {

                checkout scm
            }
        }

        stage('Validate Parameters') {

            steps {

                script {

                    if (
                        params.Environment != 'dev' &&
                        !params.IMAGE_TAG?.trim()
                    ) {

                        error(
                            "IMAGE_TAG is required for ${params.Environment}. " +
                            "Enter the image tag created by the DEV build."
                        )
                    }
                }
            }
        }

        stage('Build Frontend Image - DEV') {

            when {

                expression {
                    params.Environment == 'dev'
                }
            }

            steps {

                script {

                    frontendImage = docker.build(
                        "${env.FRONTEND_IMAGE_DEV}:${env.BUILD_NUMBER}",
                        env.BUILD_CONTEXT
                    )
                }
            }
        }

        stage('Push Frontend Image - DEV') {

            when {

                expression {
                    params.Environment == 'dev'
                }
            }

            steps {

                script {

                    docker.withRegistry(
                        env.REGISTRY_URL,
                        env.DEV_DH_CREDENTIALS
                    ) {

                        frontendImage.push(
                            "${env.BUILD_NUMBER}"
                        )
                    }
                }
            }
        }

        stage('Deploy Frontend - DEV') {

            when {

                expression {
                    params.Environment == 'dev'
                }
            }

            steps {

                script {

                    deployFrontend(
                        env.DEV_NS,
                        env.FRONTEND_IMAGE,
                        env.BUILD_NUMBER
                    )
                }
            }
        }

        stage('Deploy Frontend - QA') {

            when {

                expression {
                    params.Environment == 'qa'
                }
            }

            steps {

                script {

                    deployFrontend(
                        env.QA_NS,
                        env.FRONTEND_IMAGE,
                        params.IMAGE_TAG.trim()
                    )
                }
            }
        }

        stage('Deploy Frontend - UAT') {

            when {

                expression {
                    params.Environment == 'uat'
                }
            }

            steps {

                script {

                    deployFrontend(
                        env.UAT_NS,
                        env.FRONTEND_IMAGE,
                        params.IMAGE_TAG.trim()
                    )
                }
            }
        }

        stage('Production Approval') {

            when {

                expression {
                    params.Environment == 'prod'
                }
            }

            steps {

                input(
                    message: "Deploy frontend ${env.FRONTEND_IMAGE}:${params.IMAGE_TAG} to PROD?",
                    ok: 'Deploy to Production'
                )
            }
        }

        stage('Deploy Frontend - PROD') {

            when {

                expression {
                    params.Environment == 'prod'
                }
            }

            steps {

                script {

                    deployFrontend(
                        env.PROD_NS,
                        env.FRONTEND_IMAGE,
                        params.IMAGE_TAG.trim()
                    )
                }
            }
        }
    }

    post {

        always {

            cleanWs()
        }

        success {

            echo 'Frontend deployment completed successfully.'
        }

        failure {

            echo 'Frontend deployment failed.'
        }
    }
}


/*
 * Reusable frontend deployment function
 */
def deployFrontend(namespace, imageName, imageTag) {

    sh """

        echo "Connecting to EKS cluster..."

        echo "EKS_CLUSTER = ${env.EKS_CLUSTER}"

        echo "AWS_REGION = ${env.AWS_REGION}"

        aws eks update-kubeconfig \
            --region ${env.AWS_REGION} \
            --name ${env.EKS_CLUSTER}


        echo "Creating namespace if required..."

        kubectl create namespace ${namespace} \
            --dry-run=client \
            -o yaml | kubectl apply -f -


        echo "Applying frontend Kubernetes manifest..."

        kubectl apply \
            -f kube/frontend-service.yml \
            -f kube/frontend-deploy.yml \
            -f kube/ingress.yml \
            -n ${namespace}


        echo "Updating frontend Docker image..."

        kubectl set image \
            deployment/app-4 \
            app-4-cont=${imageName}:${imageTag} \
            -n ${namespace}


        echo "Waiting for frontend rollout..."

        kubectl rollout status \
            deployment/app-4 \
            -n ${namespace}


        echo "Frontend deployment completed."

    """
}